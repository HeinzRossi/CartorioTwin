{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cartorio-twin:schema:golden-case:1",
  "title": "Caso dourado sintético candidato do Cartório Twin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "synthetic",
    "description",
    "source",
    "pages",
    "acts",
    "reviews",
    "scenario",
    "expected"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0-draft" },
    "caseId": { "type": "string", "pattern": "^GD-[0-9]{3}$" },
    "synthetic": { "const": true },
    "description": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/act" }
    },
    "reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/review" }
    },
    "scenario": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/scenario" }
      ]
    },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "fieldValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "boolean" },
        { "type": "null" },
        { "$ref": "#/$defs/fraction" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256", "nameSanitized", "mimeType", "byteLength"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "nameSanitized": { "type": "string", "minLength": 1 },
        "mimeType": { "const": "application/pdf" },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "text", "textSha256", "strategy", "quality"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "textSha256": { "$ref": "#/$defs/sha256" },
        "strategy": { "enum": ["native_text", "ocr", "hybrid"] },
        "quality": { "enum": ["high", "low", "unknown"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceVersion",
        "sourceSha256",
        "page",
        "textSha256",
        "startUtf16",
        "endUtf16",
        "excerpt"
      ],
      "properties": {
        "sourceId": { "$ref": "#/$defs/guid" },
        "sourceVersion": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "page": { "type": "integer", "minimum": 1 },
        "textSha256": { "$ref": "#/$defs/sha256" },
        "startUtf16": { "type": "integer", "minimum": 0 },
        "endUtf16": { "type": "integer", "minimum": 1 },
        "excerpt": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "valueType", "suggestedValue", "state", "evidences"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "valueType": { "enum": ["text", "fraction", "identity", "effect"] },
        "suggestedValue": { "$ref": "#/$defs/fieldValue" },
        "state": {
          "enum": [
            "extracted",
            "under_review",
            "confirmed",
            "contested",
            "unsupported",
            "not_found",
            "declared_without_evidence"
          ]
        },
        "evidences": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetActId", "type"],
      "properties": {
        "targetActId": { "$ref": "#/$defs/guid" },
        "type": { "enum": ["reference", "rectification", "cancellation", "correspondence"] }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "identifier", "declaredType", "pages", "fields", "relations", "issues"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "order": { "type": "integer", "minimum": 1 },
        "identifier": { "type": ["string", "null"] },
        "declaredType": { "enum": ["registration", "annotation", "unsupported", "not_located"] },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actId", "fieldPath", "decision", "finalValue", "justification", "reviewerId"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "actId": { "$ref": "#/$defs/guid" },
        "fieldPath": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["confirmed", "corrected", "contested", "not_found", "declared_without_evidence"] },
        "finalValue": { "$ref": "#/$defs/fieldValue" },
        "justification": { "type": ["string", "null"] },
        "reviewerId": { "$ref": "#/$defs/guid" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transferorId", "acquirerId", "documentedFraction", "proposedFraction"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "transferorId": { "$ref": "#/$defs/guid" },
        "acquirerId": { "$ref": "#/$defs/guid" },
        "documentedFraction": { "$ref": "#/$defs/fraction" },
        "proposedFraction": { "$ref": "#/$defs/fraction" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "projectionAllowed", "findings"],
      "properties": {
        "status": { "enum": ["awaiting_review", "inconclusive", "divergent", "consistent_in_scope"] },
        "projectionAllowed": { "type": "boolean" },
        "findings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "enum": ["inconclusive", "divergent"] } }
          },
          "then": {
            "properties": { "projectionAllowed": { "const": false } }
          }
        }
      ]
    }
  }
}
